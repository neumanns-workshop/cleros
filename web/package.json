{
  "name": "cleros",
  "version": "2.0.0",
  "description": "Modern web interface for ancient Greek religious corpus with semantic search",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:embeddings": "node tests/run-all-tests.js",
    "test:transformers": "node tests/test-transformers-basic.js"
  },
  "dependencies": {
    "@types/node": "^18.19.123",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@xenova/transformers": "^2.17.2",
    "framer-motion": "^11.0.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.400.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "wordpos": "^2.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.7",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.40.0",
    "vite": "^5.3.0",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "ancient-greek",
    "orphic-hymns",
    "semantic-search",
    "digital-humanities",
    "ai",
    "transformers",
    "divination",
    "oracle"
  ],
  "author": "Cleros Project",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/neumanns-workshop/cleros.git"
